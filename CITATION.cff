cff-version: 1.2.0

title: "Blender2SIMBA"

message: "If you use Blender2SIMBA in academic work, please cite this software."

type: software

authors:
  - family-names: Mastrofini
    given-names: Alessandro
    affiliation: "Multiscale and Multiphysics Mechanics Group (M2M), Department of Civil Engineering and Computer Science Engineering, University of Rome Tor Vergata, Rome, Italy"
